{
  "manifest_version": 3,
  "name": "Notes Google pour Doctolib",
  "version": "1.1.0",
  "description": "Affiche la note Google des praticiens directement dans les résultats de recherche Doctolib, avec lien vers les avis.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.doctolib.fr/*",
    "https://places.googleapis.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.doctolib.fr/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Notes Google pour Doctolib"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
